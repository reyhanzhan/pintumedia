# Supabase (nilai publishable boleh digunakan browser; service role wajib server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Panel admin (/admin) — satu password, dipakai untuk semua akses admin.
ADMIN_PASSWORD=

# Fallback saat panel admin belum diisi. Setelah admin mengatur harga/metode
# pembayaran/API key dari /admin, nilai di panel itu yang dipakai (lihat lib/settings.ts).
# Pilih: midtrans, xendit, atau linkqu. Biarkan kosong selama pengembangan UI.
PAYMENT_PROVIDER=
PAYMENT_ENV=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DONATION_URL=

# DramaBox catalog adapter (server-side, tidak memerlukan API key)
DRAMABOX_API_BASE_URL=https://dramabox-api.zone.id

# NunoDrama multi-provider API (server-only)
NUNODRAMA_API_BASE_URL=https://go.nunodrama.my.id
NUNODRAMA_API_TOKEN=

# DramaBos unified adapter (server-only; gunakan hanya sesuai lisensi/provider terms)
DRAMABOS_API_BASE_URL=https://dramabos.live
DRAMABOS_API_KEY=
DRAMABOS_CONTENT_LICENSE_CONFIRMED=false

# Cloudflare Stream (server-only; jangan commit token ke GitHub)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=true

# Midtrans
MIDTRANS_SERVER_KEY=

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# LinkQu (virtual account, auto-unlock via webhook — no static QR)
# Isi dari dashboard/dokumen merchant LinkQu; LINKQU_VA_PATH & bentuk respons VA
# perlu dikonfirmasi ke dokumentasi merchant sebelum go-live (lihat catatan di
# lib/payments/provider.ts dan app/api/webhooks/linkqu/route.ts).
LINKQU_BASE_URL=
LINKQU_VA_PATH=
LINKQU_CLIENT_ID=
LINKQU_USERNAME=
LINKQU_PIN=
LINKQU_SERVER_KEY=
LINKQU_VA_BANK_CODE=

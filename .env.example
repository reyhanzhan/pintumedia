# Supabase (nilai publishable boleh digunakan browser; service role wajib server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pilih: midtrans atau xendit. Biarkan kosong selama pengembangan UI.
PAYMENT_PROVIDER=
PAYMENT_ENV=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DONATION_URL=

# DramaBox catalog adapter (server-side, tidak memerlukan API key)
DRAMABOX_API_BASE_URL=https://dramabox-api.zone.id

# NunoDrama multi-provider API (server-only)
NUNODRAMA_API_BASE_URL=https://go.nunodrama.my.id
NUNODRAMA_API_TOKEN=

# DramaBos unified adapter (server-only; gunakan hanya sesuai lisensi/provider terms)
DRAMABOS_API_BASE_URL=https://dramabos.live
DRAMABOS_API_KEY=
DRAMABOS_CONTENT_LICENSE_CONFIRMED=false

# Cloudflare Stream (server-only; jangan commit token ke GitHub)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=true

# Midtrans
MIDTRANS_SERVER_KEY=

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
